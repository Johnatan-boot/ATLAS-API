# ===== ATLAS API — exemplo de configuração (copie para .env e ajuste) =====
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# Banco: sqlite (desenvolvimento) | mysql (produção)
DB_CLIENT=sqlite
SQLITE_FILE=./data/atlas.db

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=atlas
MYSQL_PASSWORD=
MYSQL_DATABASE=atlas
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT_MS=10000
# Usado só pelo docker-compose (senha do root do MySQL)
MYSQL_ROOT_PASSWORD=

# Segurança — gere um segredo próprio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=atlas-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# Origens permitidas (separadas por vírgula). Em produção use apenas o domínio do ATLAS.
CORS_ORIGINS=http://localhost:3333
# true em produção (HTTPS): cookie de sessão só trafega por HTTPS
COOKIE_SECURE=false
# Cadastro público (sempre no grupo visualizador). O ATLAS usa cadastro somente por administradores.
PUBLIC_REGISTER=false
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
BODY_LIMIT_BYTES=3145728
# Servir o frontend ATLAS (pasta public/) na mesma origem da API
SERVE_FRONTEND=true

# Primeiro administrador (usado apenas por "npm run create-admin"; não deixe a senha gravada no arquivo depois)
ADMIN_EMAIL=
ADMIN_USUARIO=
ADMIN_SENHA=
