{
  "name": "atlas-api",
  "version": "1.0.0",
  "description": "API REST do sistema ATLAS (King Star) - cotações de frete, coletas, envios marketplace",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "reset-password": "tsx src/scripts/reset-password.ts",
    "reset-password:prod": "node dist/scripts/reset-password.js",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "create-admin:prod": "node dist/scripts/create-admin.js",
    "build:frontend": "python3 scripts/build-frontend.py frontend/ATLAS.html public/index.html",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:mysql": "DB_CLIENT=mysql node --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "12.11.1",
    "fastify": "5.12.7",
    "jsonwebtoken": "9.0.3",
    "mysql2": "^3.24.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
